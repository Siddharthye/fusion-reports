# ─────────────────────────────────────────────────────────────────────────────
# FUSION — every variable below is OPTIONAL.
# Copy to `.env` only if you want to change a default:
#     cp .env.example .env
# With no .env at all, FUSION runs on in-memory storage with seeded demo data.
# ─────────────────────────────────────────────────────────────────────────────

# Minimum combined affinity (0..1) for a report to join an existing incident.
# Lower it and unrelated reports start merging; raise it and duplicates leak
# through as separate incidents. 0.5 is the tested sweet spot.
FUSION_JOIN_THRESHOLD=0.5

# Milliseconds between reports during a paced demo storm. 21 reports at
# 1500ms is a ~30 second live demo; drop it for a faster storm.
FUSION_STORM_PACE_MS=1500

# Centre of the seeded demo campus (defaults to KIIT Campus 25, Bhubaneswar).
FUSION_CAMPUS_LAT=20.3536
FUSION_CAMPUS_LNG=85.8195

# ─────────────────────────────────────────────────────────────────────────────
# Persistent storage (production only).
#
# Leave BOTH unset for local development — FUSION then uses in-memory storage
# with best-effort persistence to ./.data, which needs no account and no setup.
#
# Set both to switch to Upstash Redis. Required when deploying to a serverless
# host such as Vercel, where memory does not survive between invocations.
# ─────────────────────────────────────────────────────────────────────────────
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token
